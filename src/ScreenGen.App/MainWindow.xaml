<Window x:Class="ScreenGen.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        xmlns:local="clr-namespace:ScreenGen.App"
        Title="ScreenGen — Screenshot Generator" Height="860" Width="1320"
        Background="#FF2A2A2E" TextElement.Foreground="#FFEAEAEA"
        UseLayoutRounding="True">

    <Window.Resources>
        <local:HexToBrushConverter x:Key="HexBrush"/>
        <local:BoolToBrushConverter x:Key="BoolBrush"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFD6D6D6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF9AD0FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFB6B6B6"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF1E1E22"/>
            <Setter Property="Foreground" Value="#FFEAEAEA"/>
            <Setter Property="BorderBrush" Value="#FF45454B"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF1E1E22"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF35353B"/>
            <Setter Property="Foreground" Value="#FFEAEAEA"/>
            <Setter Property="BorderBrush" Value="#FF50505A"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <!-- Clickable color swatch -> opens the native color picker -->
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,4,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Click to pick a color"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#FF888888"
                                BorderThickness="1" CornerRadius="3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#FF202024" Padding="8">
            <DockPanel>
                <!-- Device (adb) group, docked right -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Ellipse Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,6,0"
                             Fill="{Binding DeviceConnected, Converter={StaticResource BoolBrush}}"/>
                    <TextBlock Text="{Binding DeviceStatus}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="#FFC9C9CC" MinWidth="160"/>
                    <Button Content="{Binding ConnectLabel}" Command="{Binding ConnectDeviceCommand}"/>
                    <Button Content="Capture New" Command="{Binding CaptureCommand}"
                            Background="#FF2E9E5B" FontWeight="SemiBold"
                            ToolTip="Capture the phone screen and add it as a new screen"/>
                    <Button Content="Replace Current" Command="{Binding CaptureReplaceCommand}"
                            Background="#FF2E7D8C" FontWeight="SemiBold" Margin="0"
                            ToolTip="Capture the phone screen and replace the selected screen's image"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Load YAML…" Command="{Binding LoadCommand}"/>
                    <Button Content="Save YAML…" Command="{Binding SaveCommand}"/>
                    <Separator Margin="6,0" Background="#FF45454B"/>
                    <Button Content="Generate" Command="{Binding GenerateCommand}"
                            Background="#FF2D6CDF" FontWeight="SemiBold"/>
                    <Button Content="Open Output" Command="{Binding OpenOutputCommand}"/>
                    <Separator Margin="6,0" Background="#FF45454B"/>
                    <Button Content="☕ Support this project" Command="{Binding SupportCommand}"
                            Background="#FFFFDD00" Foreground="#FF111111" FontWeight="SemiBold" Margin="0"
                            ToolTip="screengen is free &amp; open source — support it on Buy Me a Coffee"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#FF202024" Padding="8,4">
            <TextBlock Text="{Binding Status}" Foreground="#FFB6B6B6"/>
        </Border>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: screens -->
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="SCREENS" Style="{StaticResource Section}" Margin="0,0,0,6"/>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Add" Command="{Binding AddScreenCommand}"/>
                    <Button Content="Remove" Command="{Binding RemoveScreenCommand}"/>
                    <Button Content="↑" Command="{Binding MoveUpCommand}" Width="32"/>
                    <Button Content="↓" Command="{Binding MoveDownCommand}" Width="32"/>
                </StackPanel>

                <!-- selected screen editor -->
                <Border DockPanel.Dock="Bottom" Background="#FF222226" Padding="8" Margin="0,8,0,0"
                        BorderBrush="#FF3A3A40" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Image" Style="{StaticResource FieldLabel}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseImageCommand}" Margin="6,0,0,0"/>
                            <TextBox Text="{Binding SelectedScreen.Image, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <TextBlock Text="Title" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding SelectedScreen.Title, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Subtitle" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding SelectedScreen.Subtitle, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinLines="2"/>
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen}"
                         Background="#FF1E1E22" BorderBrush="#FF3A3A40" Foreground="#FFEAEAEA"
                         DisplayMemberPath="Display"/>
            </DockPanel>

            <!-- CENTER: preview -->
            <DockPanel Grid.Column="1" Margin="0,0,8,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="Preview target:" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding TargetNames}" SelectedItem="{Binding PreviewTarget}" Width="220"
                              HorizontalAlignment="Left"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding PreviewInfo}" Margin="0,6,0,0"
                           HorizontalAlignment="Center" Foreground="#FFB6B6B6"/>
                <Border Background="#FF161618" BorderBrush="#FF3A3A40" BorderThickness="1">
                    <skia:SKElement x:Name="Preview" PaintSurface="OnPaintSurface"/>
                </Border>
            </DockPanel>

            <!-- RIGHT: style + targets -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="PROJECT" Style="{StaticResource Section}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Project, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="BACKGROUND" Style="{StaticResource Section}"/>
                    <ComboBox ItemsSource="{Binding BgTypes}" SelectedItem="{Binding BgType}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource Swatch}"
                                Background="{Binding BgCenter, Converter={StaticResource HexBrush}}"
                                Command="{Binding PickColorCommand}" CommandParameter="BgCenter"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BgCenter, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" ToolTip="gradient center"/>
                        <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource Swatch}"
                                Background="{Binding BgEdge, Converter={StaticResource HexBrush}}"
                                Command="{Binding PickColorCommand}" CommandParameter="BgEdge"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BgEdge, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" ToolTip="gradient edge"/>
                        <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource Swatch}"
                                Background="{Binding BgFlat, Converter={StaticResource HexBrush}}"
                                Command="{Binding PickColorCommand}" CommandParameter="BgFlat"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding BgFlat, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" ToolTip="flat color"/>
                    </Grid>

                    <TextBlock Text="TEXT" Style="{StaticResource Section}"/>
                    <CheckBox Content="Uppercase title" IsChecked="{Binding Uppercase}" Foreground="#FFD6D6D6" Margin="0,2"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource Swatch}"
                                Background="{Binding TitleColor, Converter={StaticResource HexBrush}}"
                                Command="{Binding PickColorCommand}" CommandParameter="TitleColor"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TitleColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" ToolTip="title color"/>
                        <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource Swatch}"
                                Background="{Binding SubtitleColor, Converter={StaticResource HexBrush}}"
                                Command="{Binding PickColorCommand}" CommandParameter="SubtitleColor"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SubtitleColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" ToolTip="subtitle color"/>
                    </Grid>
                    <TextBlock Style="{StaticResource FieldLabel}"><Run Text="Title size "/><Run Text="{Binding MaxSizePct, StringFormat=0.000, Mode=OneWay}"/></TextBlock>
                    <Slider Minimum="0.02" Maximum="0.12" Value="{Binding MaxSizePct}"/>
                    <TextBlock Style="{StaticResource FieldLabel}"><Run Text="Letter spacing "/><Run Text="{Binding LetterSpacing, StringFormat=0.000, Mode=OneWay}"/></TextBlock>
                    <Slider Minimum="0" Maximum="0.3" Value="{Binding LetterSpacing}"/>

                    <TextBlock Text="FONTS" Style="{StaticResource Section}"/>
                    <TextBlock Text="Title font (pick a family or browse a file)" Style="{StaticResource FieldLabel}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="File…" Command="{Binding BrowseTitleFontCommand}" Margin="6,0,0,0"/>
                        <ComboBox ItemsSource="{Binding FontFamilies}" Text="{Binding TitleFont}" IsEditable="True"/>
                    </DockPanel>
                    <TextBlock Text="{Binding TitleFontDisplay}" FontSize="11" Foreground="#FF9A9A9A" Margin="0,1,0,0"/>
                    <TextBlock Text="Subtitle font" Style="{StaticResource FieldLabel}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="File…" Command="{Binding BrowseSubtitleFontCommand}" Margin="6,0,0,0"/>
                        <ComboBox ItemsSource="{Binding FontFamilies}" Text="{Binding SubtitleFont}" IsEditable="True"/>
                    </DockPanel>
                    <TextBlock Text="{Binding SubtitleFontDisplay}" FontSize="11" Foreground="#FF9A9A9A" Margin="0,1,0,0"/>

                    <TextBlock Text="LAYOUT" Style="{StaticResource Section}"/>
                    <TextBlock Style="{StaticResource FieldLabel}"><Run Text="Top margin "/><Run Text="{Binding TopMarginPct, StringFormat=0.000, Mode=OneWay}"/></TextBlock>
                    <Slider Minimum="0" Maximum="0.2" Value="{Binding TopMarginPct}"/>
                    <TextBlock Style="{StaticResource FieldLabel}"><Run Text="Title→device gap "/><Run Text="{Binding TitleToDeviceGapPct, StringFormat=0.000, Mode=OneWay}"/></TextBlock>
                    <Slider Minimum="0" Maximum="0.2" Value="{Binding TitleToDeviceGapPct}"/>
                    <TextBlock Style="{StaticResource FieldLabel}"><Run Text="Device size "/><Run Text="{Binding DeviceWidthPct, StringFormat=0.000, Mode=OneWay}"/></TextBlock>
                    <Slider Minimum="0.3" Maximum="1.0" Value="{Binding DeviceWidthPct}"
                            ToolTip="Scales the whole device. Smaller fits fully inside; larger bleeds off the bottom."/>

                    <TextBlock Text="FRAME" Style="{StaticResource Section}"/>
                    <ComboBox ItemsSource="{Binding FrameTypes}" SelectedItem="{Binding FrameType}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Camera cutout (phones)"/>
                    <ComboBox ItemsSource="{Binding Islands}" SelectedItem="{Binding Island}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Bezel color"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource Swatch}"
                                Background="{Binding BezelColor, Converter={StaticResource HexBrush}}"
                                Command="{Binding PickColorCommand}" CommandParameter="BezelColor"/>
                        <TextBox Grid.Column="1" Text="{Binding BezelColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                    </Grid>
                    <TextBlock Style="{StaticResource FieldLabel}"><Run Text="Bezel width "/><Run Text="{Binding BezelWidthPct, StringFormat=0.000, Mode=OneWay}"/></TextBlock>
                    <Slider Minimum="0" Maximum="0.05" Value="{Binding BezelWidthPct}"/>
                    <TextBlock Style="{StaticResource FieldLabel}"><Run Text="Corner radius "/><Run Text="{Binding CornerRadiusPct, StringFormat=0.000, Mode=OneWay}"/></TextBlock>
                    <Slider Minimum="0" Maximum="0.2" Value="{Binding CornerRadiusPct}"/>

                    <TextBlock Text="OUTPUT" Style="{StaticResource Section}"/>
                    <TextBlock Text="Folder" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding OutputDir, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Format" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}"/>
                    <CheckBox Content="Also save original screenshots (originals/)" IsChecked="{Binding SaveOriginals}"
                              Foreground="#FFD6D6D6" Margin="0,6,0,2"/>

                    <TextBlock Text="DEVICE CHROME (hide Android)" Style="{StaticResource Section}"/>
                    <CheckBox Content="Hide status bar (clock/battery/icons)" IsChecked="{Binding CleanStatusBar}"
                              Foreground="#FFD6D6D6" Margin="0,2"/>
                    <TextBlock Style="{StaticResource FieldLabel}"><Run Text="Status bar height "/><Run Text="{Binding StatusBarPct, StringFormat=0.000, Mode=OneWay}"/></TextBlock>
                    <Slider Minimum="0" Maximum="0.12" Value="{Binding StatusBarPct}"/>
                    <CheckBox Content="Hide Flutter debug banner (top-right)" IsChecked="{Binding CleanDebugBanner}"
                              Foreground="#FFD6D6D6" Margin="0,6,0,2"/>
                    <TextBlock Style="{StaticResource FieldLabel}"><Run Text="Debug banner size "/><Run Text="{Binding DebugBannerPct, StringFormat=0.000, Mode=OneWay}"/></TextBlock>
                    <Slider Minimum="0" Maximum="0.35" Value="{Binding DebugBannerPct}"/>
                    <TextBlock Text="Fill (&quot;auto&quot; samples the background, or pick a color)" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource Swatch}"
                                Background="{Binding CleanFill, Converter={StaticResource HexBrush}}"
                                Command="{Binding PickColorCommand}" CommandParameter="CleanFill"/>
                        <TextBox Grid.Column="1" Text="{Binding CleanFill, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                    </Grid>

                    <TextBlock Text="TARGETS TO GENERATE" Style="{StaticResource Section}"/>
                    <ItemsControl ItemsSource="{Binding Targets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}"
                                          Foreground="#FFD6D6D6" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
